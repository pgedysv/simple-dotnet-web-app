pipeline {
    agent any 
    stages {
        stage('Build') { 
            steps {
                bat 'dotnet restore' 
                bat 'dotnet build --no-restore' 
            }
        }     
        stage('Deliver') { 
            steps {
                bat 'dotnet publish SimpleWebApi --no-restore -o publish_output' 
            }
            post {
                success {
                    archiveArtifacts 'publish_output/*.*'
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    // Copy artifacts to deployment folder
                    bat 'xcopy /E /I /Y publish_output\\* "\\\\TSITINFAPPWS039\\pgeweb\\iv2\\"'
                }
            }
            post {
                success {
                    emailext (
                        subject: "Deployment Successful - ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                        body: """
                            <h2>Deployment Completed Successfully</h2>
                            <p><strong>Project:</strong> ${env.JOB_NAME}</p>
                            <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Deployment Location:</strong> \\\\TSITINFAPPWS039\\pgeweb\\iv2</p>
                            <p><strong>Build Status:</strong> SUCCESS</p>
                            <p><strong>Timestamp:</strong> ${new Date()}</p>
                            
                            <p>The SimpleWebApi application has been successfully deployed.</p>
                        """,
                        mimeType: 'text/html',
                        to: '${DEFAULT_RECIPIENTS}'
                    )
                }
                failure {
                    emailext (
                        subject: "Deployment Failed - ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                        body: """
                            <h2>Deployment Failed</h2>
                            <p><strong>Project:</strong> ${env.JOB_NAME}</p>
                            <p><strong>Build Number:</strong> ${env.BUILD_NUMBER}</p>
                            <p><strong>Build URL:</strong> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
                            <p><strong>Build Status:</strong> FAILURE</p>
                            <p><strong>Timestamp:</strong> ${new Date()}</p>
                            
                            <p>The deployment to \\\\TSITINFAPPWS039\\pgeweb\\iv2 has failed. Please check the build logs for details.</p>
                        """,
                        mimeType: 'text/html',
                        to: '${DEFAULT_RECIPIENTS}'
                    )
                }
            }
        }
    }
}