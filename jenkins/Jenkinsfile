pipeline {
    agent any 
    stages {
        stage('Build') { 
            steps {
                bat 'dotnet restore' 
                bat 'dotnet build --no-restore' 
            }
        }     
        stage('Deliver') { 
            steps {
                bat 'dotnet publish SimpleWebApi --no-restore -o //TSITINFAPPWS039/pgeweb/iv2' 
            }
            post {
                success {
                    archiveArtifacts '//TSITINFAPPWS039/pgeweb/iv2/*.*'
                }
            }
        }
    }
}